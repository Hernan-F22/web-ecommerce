# Database Configuration (TiDB Cloud Serverless / MySQL 8.x)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=ecommerce_ops
DB_USER=your_tidb_username.root
DB_PASSWORD=your_tidb_password

# SSL Certificate Path (Optional, TiDB requires SSL)
# On Linux/Vercel standard path: /etc/ssl/certs/ca-certificates.crt
# If left empty, system default CA bundle will be utilized
DB_SSL_CA=

# App Environment (development / production)
APP_ENV=production
